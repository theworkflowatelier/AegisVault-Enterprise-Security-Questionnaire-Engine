      "name": "Node 5C: [GROUND TRUTH] Format CSV Rows"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet combinedText = '';\n\nfor (const item of items) {\n  const json = item.json || {};\n  const docName = json.name || json.fileName || 'Policy_Document';\n  let fileContent = '';\n\n  if (json.text || json.content || json.data) {\n    fileContent = json.text || json.content || json.data;\n  } else if (item.binary) {\n    for (const key of Object.keys(item.binary)) {\n      const bin = item.binary[key];\n      if (bin && bin.data) {\n        try {\n          const decoded = Buffer.from(bin.data, 'base64').toString('utf8');\n          if (!decoded.startsWith('PK') && !decoded.includes('word/numbering.xml')) {\n            fileContent += decoded;\n          }\n        } catch (e) {}\n      }\n    }\n  }\n\n  if (fileContent && typeof fileContent === 'string' && fileContent.trim().length > 0) {\n    combinedText += `=== DOCUMENT: ${docName} ===\\n${fileContent.trim()}\\n\\n--- NEXT DOCUMENT ---\\n\\n`;\n  }\n}\n\nreturn [{ json: { Master_Ground_Truth: combinedText.trim() } }];"
      },
