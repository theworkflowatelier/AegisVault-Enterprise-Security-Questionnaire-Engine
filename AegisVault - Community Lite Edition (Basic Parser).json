    {
      "parameters": {
        "jsCode": "return items.map((item, index) => {\n  const row = item.json;\n  const keys = Object.keys(row);\n  let qKey = keys.find(k => /question|inquiry|requirement|control|description|query|item/i.test(k));\n  let idKey = keys.find(k => /id|number|no|code|ref|section/i.test(k));\n  if (!qKey && keys.length > 0) {\n    qKey = keys.reduce((a, b) => String(row[a] || \"\").length > String(row[b] || \"\").length ? a : b, keys[0]);\n  }\n  return {\n    json: {\n      Normalized_ID: (idKey && row[idKey]) ? String(row[idKey]).trim() : `GEN-${index + 1}`,\n      Normalized_Question: (qKey && row[qKey]) ? String(row[qKey]).trim() : JSON.stringify(row),\n      Original_Row_Payload: row\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2784,
        192
